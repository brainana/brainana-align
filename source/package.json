{
  "name": "brainana-align",
  "private": true,
  "version": "0.17.26-workflow-ui.1",
  "packageManager": "pnpm@11.13.0",
  "type": "module",
  "scripts": {
    "version:generate": "node ../scripts/generate-version.mjs",
    "dev": "pnpm run version:generate && vite --host 0.0.0.0",
    "build": "pnpm run version:generate && tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:server": "node ../tests/server-local-smoke.mjs",
    "verify:release": "node ../scripts/verify-release.mjs",
    "check": "pnpm run build && pnpm run test:identity && pnpm run test:documentation && pnpm run test:architecture && pnpm run test:workflow-ui && pnpm run test:coordinates && pnpm run test:window-projection && pnpm run test:optimization-windows && pnpm run test:window-interaction && pnpm run test:sessions && pnpm run test:runtime && pnpm run test:scientific && pnpm run test:linear-registration && pnpm run test:linear-controls && pnpm run test:automatic-linear && pnpm run test:nonlinear-landmarks && pnpm run test:server && pnpm run test:security && pnpm run test:browser && pnpm run test:browser-compat && pnpm run test:browser-matrix && pnpm run test:storage && pnpm run test:local-export && pnpm run test:platform && pnpm run test:sftp && pnpm run test:electron && pnpm run test:electron-remote && pnpm run test:remote-endpoint && pnpm run test:launch-handshake && pnpm run test:macos-runtime && pnpm run test:lifecycle && pnpm run test:lifecycle-detach && pnpm run test:lifecycle-launchd && pnpm run test:ssh-cancel && pnpm run test:ssh-terminal && pnpm run test:terminal-autoclose && pnpm run test:local-startup",
    "test:identity": "node ../scripts/check-release-identity.mjs",
    "test:optimization-windows": "node ../tests/optimization-windows-unit.mjs",
    "test:architecture": "node ../tests/source-architecture.mjs",
    "test:workflow-ui": "node ../tests/workflow-ui-source.mjs",
    "test:coordinates": "node ../tests/coordinate-modules-unit.mjs",
    "test:window-projection": "node --import tsx ../tests/window-projection-regression.ts",
    "test:sessions": "node ../tests/session-export-modules-unit.mjs",
    "test:runtime": "node ../tests/runtime-modules-unit.mjs",
    "test:browser": "node ../tests/browser-ui-regression.mjs",
    "test:scientific": "node --import tsx ../tests/scientific-regression.ts",
    "test:linear-registration": "node --import tsx ../tests/linear-registration-regression.ts",
    "test:linear-controls": "node ../tests/linear-controls-source.mjs",
    "test:status-overlay": "node ../tests/status-overlay-source.mjs && node ../tests/user-feedback-source.mjs",
    "test:nonlinear-landmarks": "node --import tsx ../tests/nonlinear-landmark-regression.ts && node ../tests/nonlinear-controls-source.mjs",
    "test:nonlinear-controls": "node ../tests/nonlinear-controls-source.mjs",
    "test:deformable-registration": "node --import tsx ../tests/deformable-registration-regression.ts && node ../tests/deformable-controls-source.mjs",
    "test:image-pyramid": "node --import tsx ../tests/image-pyramid-regression.ts && node ../tests/opacity-performance-source.mjs",
    "test:automatic-linear": "node --import tsx ../tests/automatic-linear-regression.ts && node ../tests/automatic-linear-ui-source.mjs",
    "test:security": "node ../tests/server-security.mjs",
    "test:storage": "node ../tests/server-storage.mjs",
    "test:platform": "node ../tests/platform-core.mjs",
    "test:sftp": "node ../tests/sftp-transport.mjs",
    "test:browser-compat": "node ../tests/browser-compatibility.mjs",
    "test:launch-handshake": "python3 ../tests/launch-handshake-stress.py",
    "test:macos-runtime": "bash ../tests/macos-runtime-selection.sh",
    "test:window-interaction": "node ../tests/optimization-window-interaction-unit.mjs",
    "test:local-export": "node ../tests/server-local-export.mjs",
    "test:lifecycle": "bash ../tests/macos-lifecycle-source.sh",
    "test:lifecycle-detach": "python3 ../tests/lifecycle-detach-stress.py",
    "test:lifecycle-launchd": "bash ../tests/macos-launchd-lifecycle.sh",
    "test:ssh-cancel": "bash ../tests/macos-ssh-cancellation.sh",
    "test:ssh-terminal": "bash ../tests/macos-ssh-terminal-launch.sh",
    "test:terminal-autoclose": "bash ../tests/macos-terminal-autoclose.sh",
    "test:browser-matrix": "node ../tests/browser-engine-matrix.mjs",
    "test:local-startup": "bash ../tests/macos-local-startup.sh",
    "test:documentation": "node ../tests/documentation-layout.mjs",
    "electron:start": "pnpm run build && electron electron/main.mjs",
    "electron:package:mac": "pnpm run build && bash ../scripts/build-electron-macos.sh --assemble-only",
    "test:electron": "node ../tests/electron-source.mjs",
    "test:electron-remote": "node ../tests/electron-remote-source.mjs",
    "test:remote-endpoint": "node ../tests/remote-endpoint-cors.mjs && node --import tsx ../tests/remote-endpoint-state.ts"
  },
  "dependencies": {
    "@niivue/niivue": "^0.69.0",
    "fflate": "^0.8.2",
    "nifti-reader-js": "^0.8.0"
  },
  "devDependencies": {
    "electron": "39.2.7",
    "playwright-core": "^1.61.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "main": "electron/main.mjs"
}
