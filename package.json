{
  "name": "brainana-align",
  "private": true,
  "version": "0.18.0",
  "type": "module",
  "description": "Brainana Align standalone registration application",
  "author": "Brainana",
  "main": "apps/align/desktop.mjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "version:generate": "node scripts/generate-version.mjs",
    "dev": "npm run dev:desktop",
    "build": "npm run build --workspace @brainana/align",
    "preview": "vite preview --host 0.0.0.0",
    "test:server": "node tests/server-local-smoke.mjs",
    "verify:release": "node scripts/verify-desktop-release.mjs",
    "check": "npm run build && npm run test:identity && npm run test:documentation && npm run test:architecture && npm run test:coordinates && npm run test:windows && npm run test:window-interaction && npm run test:sessions && npm run test:runtime && npm run test:scientific && npm run test:landmarks && npm run test:nifti && npm run test:production-ui && npm run test:guided && npm run test:server && npm run test:security && npm run test:browser && npm run test:browser-compat && npm run test:browser-matrix && npm run test:storage && npm run test:local-export && npm run test:platform && npm run test:sftp && npm run test:launch-handshake && npm run test:macos-runtime && npm run test:macho && npm run test:lifecycle && npm run test:lifecycle-detach && npm run test:lifecycle-launchd && npm run test:ssh-cancel && npm run test:ssh-terminal && npm run test:local-startup && npm run test:desktop && npm run test:workflow && npm run test:automatic && npm run test:automatic-ui && npm run test:settings && npm run test:desktop-preferences && npm run test:workspace-reset && npm run test:window-capture && npm run test:nonlinear && npm run test:nonlinear-worker && npm run test:desktop-packaging && npm run test:export-dialog && npm run test:registration-workflow && npm run test:working-volumes && npm run test:preparation-ui && npm run test:native-export-worker && npm run test:initial-processing && npm run test:display-intensity && npm run test:threshold-mask && npm run test:manual-affine && npm run test:guide-export-inspection && npm run test:guided-decisions && npm run test:audit && npm run test:voxel-brush && npm run test:welcome-hover && npm run test:data-sources && npm run test:network-browser && npm run test:guide-teaching && npm run test:guide-orderings && npm run test:guide-startup && npm run test:guide-modals && npm run test:pyramid-audit && npm run test:landmark-list && npm run test:worker-task && npm run test:export-portability && npm run test:landmark-quality && npm run test:operation-state && npm run test:overlay-worker && npm run test:advanced-registration && npm run test:acquisition-itk-ui && npm run test:displacement-simpleitk && npm run test:itk-service && npm run test:guide-methods && npm run test:linear-defaults && npm run test:viewer-rendering && npm run test:flip-inspection",
    "test:identity": "node scripts/check-release-identity.mjs",
    "test:windows": "node tests/optimization-windows-unit.mjs",
    "test:architecture": "node tests/source-architecture.mjs",
    "test:coordinates": "node tests/coordinate-modules-unit.mjs",
    "test:sessions": "node tests/session-export-modules-unit.mjs",
    "test:runtime": "node tests/runtime-modules-unit.mjs",
    "test:browser": "node tests/browser-ui-regression.mjs",
    "test:scientific": "node --import tsx tests/scientific-regression.ts",
    "test:security": "node tests/server-security.mjs",
    "test:storage": "node tests/server-storage.mjs",
    "test:platform": "node tests/platform-core.mjs",
    "test:sftp": "node tests/sftp-transport.mjs",
    "test:browser-compat": "node tests/browser-compatibility.mjs",
    "test:launch-handshake": "python3 tests/launch-handshake-stress.py",
    "test:macos-runtime": "bash tests/macos-runtime-selection.sh",
    "test:window-interaction": "node tests/optimization-window-interaction-unit.mjs",
    "test:local-export": "node tests/server-local-export.mjs",
    "test:lifecycle": "bash tests/macos-lifecycle-source.sh",
    "test:lifecycle-detach": "python3 tests/lifecycle-detach-stress.py",
    "test:lifecycle-launchd": "bash tests/macos-launchd-lifecycle.sh",
    "test:ssh-cancel": "bash tests/macos-ssh-cancellation.sh",
    "test:ssh-terminal": "bash tests/macos-ssh-terminal-launch.sh",
    "test:browser-matrix": "node tests/browser-engine-matrix.mjs",
    "test:local-startup": "bash tests/macos-local-startup.sh",
    "test:documentation": "node tests/documentation-layout.mjs",
    "test:landmarks": "node --import tsx tests/landmark-models-regression.mts",
    "test:nifti": "node --import tsx tests/nifti-geometry-regression.mts",
    "test:production-ui": "node --experimental-vm-modules tests/production-landmark-ui.mjs",
    "test:macho": "node tests/macho-runtime.mjs",
    "test:guided": "node --import tsx tests/guided-setup-regression.mts",
    "dev:desktop": "npm run build && electron .",
    "dev:web": "npm run dev --workspace @brainana/align",
    "start": "electron .",
    "dist:desktop": "npm run build && npm run desktop:prepare && electron-builder --config apps/align/electron-builder.yml --publish never",
    "test:desktop": "node --experimental-vm-modules tests/desktop-regression.mjs",
    "start:web": "npm run build && node apps/align/launch.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "test:workflow": "node --import tsx tests/workflow-ui-regression.mts",
    "test:automatic": "node --import tsx tests/automatic-registration-regression.mts && node --import tsx tests/foreground-nearby-regression.mts",
    "test:automatic-ui": "node --import tsx tests/automatic-worker-ui-regression.mts",
    "test:settings": "node --import tsx tests/settings-regression.mts",
    "test:desktop-preferences": "node --experimental-vm-modules tests/desktop-preferences-regression.mjs",
    "test:workspace-reset": "node --import tsx tests/workspace-reset-regression.mts",
    "test:window-capture": "node --import tsx tests/window-capture-regression.mts",
    "test:nonlinear": "node --import tsx tests/nonlinear-spline-regression.mts",
    "test:nonlinear-worker": "node --import tsx tests/nonlinear-worker-regression.mts",
    "test:desktop-packaging": "node --experimental-vm-modules tests/desktop-packaging-regression.mjs",
    "browser:prepare": "node scripts/prepare-browser.mjs",
    "dist:windows": "npm run build && electron-builder --config apps/align/electron-builder.yml --win --x64 --publish never",
    "dist:ubuntu": "npm run build && electron-builder --config apps/align/electron-builder.yml --linux --x64 --publish never",
    "test:export-dialog": "node --import tsx tests/export-dialog-regression.mts",
    "test:registration-workflow": "node --import tsx tests/registration-workflow-regression.mts",
    "test:working-volumes": "node --import tsx tests/working-volume-regression.mts",
    "test:preparation-ui": "node --import tsx tests/preparation-ui-regression.mts",
    "test:native-export-worker": "node --import tsx tests/native-export-worker-regression.mts",
    "test:initial-processing": "node --import tsx tests/initial-processing-regression.mts",
    "test:display-intensity": "node --import tsx tests/display-intensity-regression.mts",
    "test:threshold-mask": "node --import tsx tests/threshold-mask-regression.mts",
    "test:manual-affine": "node --import tsx tests/manual-affine-regression.mts",
    "test:guide-export-inspection": "node --import tsx tests/guide-export-inspection-regression.mts",
    "test:guided-decisions": "node --import tsx tests/guided-decisions-regression.mts",
    "test:audit": "node --import tsx tests/audit-regression.mts",
    "test:voxel-brush": "node --import tsx tests/voxel-brush-regression.mts",
    "test:welcome-hover": "node --import tsx tests/welcome-hover-regression.mts",
    "test:data-sources": "node --experimental-vm-modules --import tsx tests/data-sources-regression.mts",
    "test:network-browser": "node tests/network-browser-regression.mjs && node --import tsx tests/network-browser-ui-regression.mts && node tests/network-known-hosts-regression.mjs && node tests/network-hostkey-regression.mjs",
    "test:guide-teaching": "node --import tsx tests/guide-teaching-regression.mts",
    "test:guide-orderings": "node --import tsx tests/guide-orderings-regression.mts",
    "test:guide-startup": "node --import tsx tests/guide-startup-regression.mts",
    "test:guide-modals": "node --import tsx tests/guide-modal-regression.mts",
    "test:pyramid-audit": "node --import tsx tests/pyramid-audit-regression.mts",
    "test:landmark-list": "node --import tsx tests/landmark-list-regression.mts",
    "test:worker-task": "node --import tsx tests/worker-task-regression.mts",
    "benchmark:pyramid": "node --import tsx scripts/benchmark-pyramid.mts",
    "test:jip": "node --import tsx tests/jip-integration-regression.mts && node --import tsx tests/jip-ui-regression.mts",
    "test:jip-service": "node tests/jip-service-regression.mjs",
    "test:jip-ipc": "node --experimental-vm-modules tests/jip-ipc-regression.mjs",
    "test:jip-efficiency": "node --import tsx tests/jip-efficiency-regression.mts && node tests/jip-binary-service-regression.mjs",
    "test:manual-preview": "node --import tsx tests/manual-preview-regression.mts",
    "test:jip-sampling": "node tests/jip-sampling-service-regression.mjs",
    "test:export-portability": "node --import tsx tests/export-portability-regression.mts",
    "test:landmark-quality": "node --import tsx tests/landmark-quality-regression.mts && node --import tsx tests/landmark-quality-worker-regression.mts",
    "test:operation-state": "node --import tsx tests/operation-state-regression.mts",
    "test:overlay-worker": "node --import tsx tests/overlay-worker-regression.mts",
    "test:advanced-registration": "node --import tsx tests/advanced-registration-regression.mts",
    "test:acquisition-itk-ui": "node --import tsx tests/acquisition-itk-ui-regression.mts",
    "test:displacement-simpleitk": "node --import tsx tests/displacement-simpleitk-regression.mts",
    "test:itk-service": "node --import tsx tests/itk-service-regression.mts",
    "test:guide-methods": "node --import tsx tests/guide-registration-methods-regression.mts",
    "test:linear-defaults": "node --import tsx tests/linear-defaults-regression.mts && node --import tsx tests/linear-defaults-worker.mts",
    "test:viewer-rendering": "node --import tsx tests/viewer-rendering-regression.mts",
    "test:flip-inspection": "node --import tsx tests/flip-inspection-regression.mts",
    "ci:test": "node scripts/ci/test.mjs",
    "ci:config": "node scripts/ci/release-config.mjs",
    "ci:verify-package": "node scripts/ci/verify-package.mjs",
    "test": "npm run ci:test",
    "set-version": "node scripts/set-version.mjs",
    "test:publication": "node tests/publication-regression.mjs"
  },
  "dependencies": {
    "@brainana/core-desktop": "*",
    "@brainana/core-launcher": "*",
    "@brainana/core-server": "*"
  },
  "devDependencies": {
    "electron": "43.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "overrides": {
    "sprintf-js": "^1.1.4"
  },
  "homepage": "https://github.com/brainana/brainana-align",
  "desktopName": "brainana-align.desktop",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainana/brainana-align.git"
  },
  "bugs": {
    "url": "https://github.com/brainana/brainana-align/issues"
  }
}
