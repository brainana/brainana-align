await assert.rejects(runIntensityRegistration({fixed,moving:moved,settings:{...s,rotationRanges:[180,180,180]},foreground:'fixed-nonzero',operation:'global',metric:'mi',bins:32,fixedWindows:[],movingWindows:[]},()=>{}),/30 degrees/)
await assert.rejects(runIntensityRegistration({fixed,moving:moved,settings:s,normalization:'mean',operation:'global',metric:'least-squares',bins:32,fixedWindows:[],movingWindows:[]},()=>{}),/MI or NMI/)
await assert.rejects(runIntensityRegistration({fixed,moving:moved,settings:s,foreground:'fixed-nonzero',operation:'global',metric:'mi',bins:32,fixedWindows:[],movingWindows:[]},()=>{},()=>true),/cancelled/)
const fit:any={direction:'ct-mri',model:'rigid',parameterCount:6,matrix:result.matrix,inverse:invertAffine(result.matrix),baseMatrix:result.matrix,landmarkMatrix:result.matrix,initializationSource:'automatic',rms:0,manual:[0,0,0,0,0,0],landmarkSnapshot:[],landmarksChanged:false,fittedAt:'test',diagnostics:diagnoseTransform(result.matrix),reflectionConfirmed:false,automaticRegistration:{operation:'global',model:'rigid',parameterCount:6,settings:s,foreground:'fixed-nonzero',normalization:'mean',metric:'mi',bins:40,scoreBefore:result.scoreBefore,scoreAfter:result.scoreAfter,candidatesEvaluated:result.candidatesEvaluated,warnings:[],samplingDiagnostics:result.samplingDiagnostics}}
