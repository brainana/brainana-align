import assert from 'node:assert/strict'
import {createRequire} from 'node:module'
import {DEFAULT_PREFERENCES,THEMES,initializePreferences,getPreferences,normalizePreferences,savePreferences,contrastRatio,preferenceStorage} from '../apps/align/src/preferences'
import {installSettings,rememberDataset} from '../apps/align/src/settingsUI'
import {applyDisplayPreferences} from '../apps/align/src/displayPreferences'
import {configureReviewAppearance,updateReviewOpacity} from '../apps/align/src/reviewAppearance'
const {JSDOM}=createRequire(import.meta.url)('jsdom')
const memory=new Map<string,any>(),writes:string[]=[],ticks:Array<()=>void>=[];let fail=false,restore:any=null,activeBusy=false,defaultsApplied=0
function context(port:number){const dom=new JSDOM('<button id="settings-open">Settings</button><main></main>',{url:`http://127.0.0.1:${port}`,pretendToBeVisual:true});const w=dom.window;Object.assign(globalThis,{window:w,document:w.document,HTMLInputElement:w.HTMLInputElement,CustomEvent:w.CustomEvent,Event:w.Event});w.setInterval=(fn:()=>void)=>{ticks.push(fn);return ticks.length};w.brainanaPreferences={read:async(key:string)=>structuredClone(memory.get(key)??null),write:async(key:string,value:unknown)=>{if(fail)throw new Error('disk unavailable');writes.push(key);memory.set(key,structuredClone(value))},chooseExportFolder:async()=>{memory.set('export',{folder:'/tmp/outputs'});return '/tmp/outputs'}};return dom}
let dom=context(12340);await initializePreferences();assert.deepEqual(getPreferences(),DEFAULT_PREFERENCES)
assert.equal(normalizePreferences({saving:{rememberLayout:true}}).saving.rememberLayout,false,'Legacy expansion preferences cannot override collapsed startup');
assert.equal(contrastRatio('#000000','#ffffff'),21);assert.equal(contrastRatio('#ffffff','#ffffff'),1)
const hostile=normalizePreferences({schemaVersion:1,appearance:{scale:99,colors:{text:'url(secret)',bg:'#abcdef'}},display:{opacity:Infinity,fixedColor:'bad'},registration:{model:'deformable',translationLimit:-99},saving:{interval:1}})
assert.equal(hostile.appearance.scale,1.5);assert.equal(hostile.appearance.colors.text,DEFAULT_PREFERENCES.appearance.colors.text);assert.equal(hostile.display.opacity,55);assert.equal(hostile.registration.model,'rigid');assert.equal(hostile.registration.translationLimit,.05);assert.equal(hostile.saving.interval,10);assert.throws(()=>normalizePreferences({schemaVersion:99}))
const old={application:'Brainana Align',schemaVersion:3,savedAt:'2026-10-10T12:00:00Z',landmarks:[],direction:'ct-mri'};memory.set('recovery',old)
let session:any={...old,savedAt:'2026-10-11T12:00:00Z',landmarks:[{id:1,mri:[1,2,3],ct:[3,2,1],enabled:true}]}
installSettings({status:()=>{},recover:async value=>{restore=value},session:()=>session,hasWork:()=>true,busy:()=>activeBusy})
window.addEventListener('align-registration-defaults',()=>defaultsApplied++)
const wait=async()=>{await new Promise(r=>setTimeout(r,25))},click=async(id:string)=>{(document.querySelector('#'+id) as HTMLButtonElement).click();await wait()},tab=async(name:string)=>{(document.querySelector(`[data-section="${name}"]`) as HTMLButtonElement).click();await wait()},change=async(group:string,key:string,value:any)=>{const el=document.querySelector(`[data-group="${group}"][data-key="${key}"]`) as HTMLInputElement;if(el.type==='checkbox')el.checked=value;else el.value=String(value);el.dispatchEvent(new Event(['color','range'].includes(el.type)?'input':'change',{bubbles:true}));await wait()}
await wait();const open=document.querySelector('#settings-open') as HTMLButtonElement;open.focus();await click('settings-open');assert.equal(document.querySelector('#settings-modal')!.classList.contains('hidden'),false)
await change('appearance','theme','light');assert.equal(document.documentElement.style.getPropertyValue('--bg'),THEMES.light.bg);assert.equal(document.documentElement.style.colorScheme,'light');assert.equal(getPreferences().display.movingColor,'#ff00ff')
await change('colors','text','#ffffff');await change('colors','panel','#ffffff');assert.equal(getPreferences().appearance.theme,'custom');assert(document.querySelector('#settings-contrast')!.textContent!.includes('warning'))
;(document.querySelector('#settings-preset-name') as HTMLInputElement).value='<script>named</script>';await click('settings-preset-save');assert(memory.get('presets')['<script>named</script>']);assert.equal(document.querySelector('#settings-presets script'),null)
await click('settings-reset-section');assert.equal(getPreferences().appearance.theme,'amber');const presets=document.querySelector('#settings-presets') as HTMLSelectElement;presets.value='<script>named</script>';await click('settings-preset-load');assert.equal(getPreferences().appearance.theme,'custom')
await tab('display');await change('display','fixedColor','#ff8000');await change('display','movingColor','#0080ff');await change('display','markerSize',2);await change('display','crosshairVisible',false)
const colors:any[]=[];let uploads=0;const nv:any={volumes:[{},{}],setCustomSliceShader:()=>{},addColormap:(name:any,color:any)=>colors.push({name,color}),updateGLVolume:()=>uploads++,drawScene:()=>{}};configureReviewAppearance([nv],'falsecolor',.4);assert.equal(nv.volumes[0].colormap,'brainanaFixed');assert.equal(nv.volumes[1].colormap,'brainanaMoving');assert.deepEqual(colors.find(v=>v.name==='brainanaMoving').color.B,[0,128,255]);const count=uploads;updateReviewOpacity([nv],.9);assert.equal(uploads,count,'opacity remains a shader-only redraw')
const beforeDisplay=structuredClone(getPreferences().display),opacityOnly={...beforeDisplay,opacity:81};const modeControl=document.createElement('select'),opacityControl=document.createElement('input'),opacityLabel=document.createElement('span');let appearanceChanges=0
const displayOptions={mri:[],ct:[],review:[nv],mode:modeControl,opacity:opacityControl,opacityLabel,appearance:()=>{appearanceChanges++;configureReviewAppearance([nv],'falsecolor',.4)}}
applyDisplayPreferences(displayOptions,opacityOnly,beforeDisplay);assert.equal(appearanceChanges,0);assert.equal(uploads,count,'persisting opacity must not rebuild textures');assert.equal(opacityLabel.textContent,'81%')
applyDisplayPreferences(displayOptions,{...opacityOnly,markerLabels:false},opacityOnly);assert.equal(uploads,count,'marker preference changes must not rebuild textures')
applyDisplayPreferences(displayOptions,{...opacityOnly,movingColor:'#ffffff'},opacityOnly);assert.equal(appearanceChanges,1,'tint changes rebuild colormaps once')

await tab('guide');await change('guide','dock',true);assert(document.body.classList.contains('guide-docked'))
await tab('registration');await change('registration','preset','tight');assert.equal(getPreferences().registration.rotationLimit,1);assert.equal(getPreferences().registration.translationStep,1);await change('registration','rotationLimit',3);assert.equal(getPreferences().registration.preset,'custom');assert.equal(defaultsApplied,0);activeBusy=true;await click('settings-apply-registration');assert.equal(defaultsApplied,0);activeBusy=false;await click('settings-apply-registration');assert.equal(defaultsApplied,1)
await tab('saving');await change('saving','interval',0);assert.equal(getPreferences().saving.interval,10);assert.equal((document.querySelector('[data-group="saving"][data-key="interval"]') as HTMLInputElement).value,'10');await change('saving','interval',30);await click('settings-export-folder-choose');assert(document.querySelector('#settings-export-folder')!.textContent!.includes('/tmp/outputs'));await click('settings-recover');assert.deepEqual(restore,old)
for(let i=0;i<30;i++)ticks.at(-1)!();await wait();assert.deepEqual(memory.get('recovery').current,session);assert.deepEqual(memory.get('recovery').previous,old)
await rememberDataset('MRI','example.nii');await rememberDataset('MRI','example.nii');assert.equal(memory.get('recent').length,1)
await click('settings-close');assert.equal(document.activeElement,open)
const stored=structuredClone(getPreferences());dom.window.close();dom=context(12341);await initializePreferences();assert.deepEqual(getPreferences(),stored,'desktop preferences survive changed launch port');assert.deepEqual(await preferenceStorage.read('recovery'),memory.get('recovery'))
// Storage failure does not replace the last successfully persisted preferences.
fail=true;const changed=structuredClone(getPreferences());changed.appearance.theme='dark';await assert.rejects(savePreferences(changed),/disk unavailable/);assert.deepEqual(getPreferences(),stored);fail=false
await savePreferences(DEFAULT_PREFERENCES);assert.equal(getPreferences().registration.model,'rigid');assert(memory.has('presets'),'restoring defaults keeps named configurations')
dom.window.close();console.log('Settings: normalization, contrast, live themes/tints, named configurations, bounded registration defaults, recovery retention, port-independent desktop persistence, and failed-write preservation passed.')
